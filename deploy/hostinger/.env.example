# Copy this file to .env on the server and replace every required value.
# Never commit the real .env file or paste secrets into chat.

NODE_ENV=production
PORT=8080
APP_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
SESSION_SECRET=generate-a-long-random-32-byte-secret

# PostgreSQL. Use either DATABASE_URL or SUPABASE_DB_URL.
# DATABASE_SSL defaults to enabled. Set it to false only for a local trusted DB.
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/tapboss?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Clerk production instance. Register your domain and /api/__clerk proxy in Clerk.
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# Optional when Clerk is configured to use an explicit proxy URL:
# VITE_CLERK_PROXY_URL=https://your-domain.example/api/__clerk

# Direct Google Gemini API access (required for AI features).
GEMINI_API_KEY=replace_me

# Direct Resend API access (required for invitation and report email).
RESEND_API_KEY=re_replace_me
EMAIL_FROM=TapasHub <noreply@your-domain.example>

# Persistent application data. Keep this outside the release directory.
OBJECT_STORAGE_DIR=/home/your-user/tapboss-data/objects
PUBLIC_OBJECT_DIR=/home/your-user/tapboss-data/public
BROWSER_PROFILES_DIR=/home/your-user/tapboss-data/browser-profiles
# Set this if Chromium is not discoverable in PATH.
# BROWSER_CHROMIUM_PATH=/usr/bin/chromium

# LiveKit is optional until meetings are enabled, but all three are required
# together for live meeting tokens to work.
LIVEKIT_URL=wss://your-livekit-host.example
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Optional feature controls.
AI_PRODUCTS_ENABLED=true
AI_TASKS_ENABLED=true
LOG_LEVEL=info
# AI_TASKS_ENABLED=false
# AI_PRODUCTS_ENABLED=false